# Local Express port; align the Vite development proxy target if changed.
PORT=5000
# Server-only database URI. Use your deployment secret settings for production credentials; never commit a real .env.
MONGODB_URI=mongodb://localhost:27017/shivam-portfolio
# Exact permitted frontend origin for CORS, including protocol/port. Change for your production frontend.
CLIENT_ORIGIN=http://localhost:5173
# development enables local behavior; tests set test to prevent automatic listening, production should use production.
NODE_ENV=development

# Optional: verified reverse-proxy hop count; leave unset for direct connections.
# TRUST_PROXY_HOPS=1
